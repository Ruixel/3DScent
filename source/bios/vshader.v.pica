; Vertex shader: position + texcoord, for the textured back_buffer quad
; Written in the same style as the known-working triangle shader, so if the
; triangle shader works on hardware and this one doesn't, the problem is
; genuinely in the texture pipeline (not the shader structure).

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos  position
.out outtex  texcoord0

; Inputs (from vertex buffer, v0 and v1)
.in inpos  v0
.in intex  v1

.entry vmain
.proc vmain
    ; Force w=1 on the input position
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Pass texcoord through. Write all 4 components explicitly so .zw aren't
    ; left undefined — PICA200 samplers can behave oddly with garbage zw.
    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    end
.end
