; PICA200 vertex shader - positions + texcoords for back_buffer quad

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias ones myconst.yyyy

; Outputs
.out outpos position
.out outtex texcoord0

; Inputs
.alias inpos v0
.alias intex v1

.proc main
    ; Build vec4 from xyz position
    mov r0.xyz, inpos
    mov r0.w, ones

    ; outpos = projection * pos
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; pass texcoord straight through
    mov outtex.xy, intex.xy

    end
.end
