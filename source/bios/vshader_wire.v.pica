; Vertex shader for wireframe overlay
; Input:  v0 = position (xyz in game screen space)
; Output: clip-space position, uniform color passed through to fragment stage
;
; Written in the same style as the working texcoord shader — explicit .entry
; and .in declarations so hardware is happy.

; Uniforms
.fvec projection[4]
.fvec wireColor       ; single color for all wireframe lines (r,g,b,a)

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  ones myconst.yyyy

; Outputs
.out outpos position
.out outclr color

; Inputs
.in inpos v0

.entry vmain
.proc vmain
    ; Build vec4 from xyz position
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Forward the uniform color to the fragment stage
    mov outclr, wireColor

    end
.end
