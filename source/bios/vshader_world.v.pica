; Vertex shader for textured world geometry
; Input:  v0 = position (xyz, in DESCENT CAMERA SPACE - left-handed, +Z forward)
;         v1 = texcoord (uv)
; Output: clip-space position with proper W (so GPU does perspective-correct
;         attribute interpolation), texcoord passed through.
;
; The projection uniform is a perspective matrix configured by C code, which
; transforms camera-space (+Z forward, +Y up, left-handed) directly to PICA200
; clip space (with the extra rotation OrthoTilt-style for the 3DS's rotated
; framebuffer).

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtex texcoord0

; Inputs
.in inpos v0
.in intex v1

.entry vmain
.proc vmain
    ; Build vec4 from xyz position (w=1 for perspective transform)
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0 — produces (x*w, y*w, z*w, w) in clip space.
    ; The PICA200 will then do perspective divide (xyz/w) and viewport
    ; transform automatically. Because w is preserved, attribute interpolation
    ; (the texcoord) is perspective-correct.
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Pass texcoord, zero out z/w
    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    end
.end
