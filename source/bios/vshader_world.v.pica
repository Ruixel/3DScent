; Vertex shader for textured world geometry with per-vertex lighting
; Input:  v0 = position (xyz, camera space)
;         v1 = texcoord (uv)
;         v2 = light (single float)
;         v3 = color (rgba, unsigned byte normalized to 0-1)
; Output: clip-space position, texcoord, and lit color passed through.

.fvec projection[4]

.constf myconst(0.0, 1.0, 0.0, 0.0)
.constf norm255(0.003921569, 0.003921569, 0.003921569, 1.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.out outpos position
.out outtex texcoord0
.out outcol color

.in inpos   v0
.in intex   v1
.in inlight v2
.in incolor v3

.entry vmain
.proc vmain
    mov r0.xyz, inpos
    mov r0.w,   ones

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    mov r1, incolor
    mul r1.rgb, norm255, r1      ; normalize to 0-1
    mul outcol.rgb, inlight.xxx, r1
    mov outcol.a, ones

    end
.end
