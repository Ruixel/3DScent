; Vertex shader for textured world geometry
; Input:  v0 = position (xyz, in 3DS screen space - we project on CPU)
;         v1 = texcoord (uv)
; Output: clip-space position, texcoord passed through
;
; Style matches the working texcoord shader: explicit .entry, .in declarations.
; PICA200 hardware is strict about these.

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtex texcoord0

; Inputs
.in inpos v0
.in intex v1

.entry vmain
.proc vmain
    ; Build vec4 from xyz position
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Pass texcoord, zero out z/w
    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    end
.end
