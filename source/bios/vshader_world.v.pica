; Vertex shader for textured world geometry with per-vertex lighting
; Input:  v0 = position (xyz, in DESCENT CAMERA SPACE - left-handed, +Z forward)
;         v1 = texcoord (uv)
;         v2 = color (rgb), per-vertex lighting from fade-table lookup
; Output: clip-space position with proper W (so GPU does perspective-correct
;         attribute interpolation), texcoord and color passed through.
;         Color becomes "primary color" in TEV stages and is multiplied
;         with the texture sample to produce final lit pixel.

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtex texcoord0
.out outcol color

; Inputs
.in inpos v0
.in intex v1
.in incol v2

.entry vmain
.proc vmain
    ; Build vec4 from xyz position (w=1 for perspective transform)
    mov r0.xyz, inpos
    mov r0.w,   ones

    ; outpos = projection * r0 — produces (x*w, y*w, z*w, w) in clip space.
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Pass texcoord, zero out z/w
    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    ; Pass per-vertex color to fragment stage. Alpha=1.
    mov outcol.rgb, incol
    mov outcol.a,   ones

    end
.end
